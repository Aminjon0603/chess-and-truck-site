{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/events",
      "destination": "/index.html"
    },
    {
      "source": "/events/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tournaments",
      "destination": "/index.html"
    },
    {
      "source": "/after-school",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/camps",
      "destination": "/index.html"
    },
    {
      "source": "/camps/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/lessons",
      "destination": "/index.html"
    },
    {
      "source": "/lessons/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/private-lessons",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/interest/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/interest/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/interest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/camps/confirmed",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dojo",
      "destination": "/",
      "permanent": true
    }
  ]
}
